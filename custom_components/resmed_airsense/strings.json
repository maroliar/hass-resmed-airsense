        "description": "Choose the machine to pair.",
        "data": {
          "address": "Device"
        }
      },
      "connect": {
        "title": "Pair {name}",
        "description": "Only one app can be paired with the machine: pairing Home Assistant replaces the myAir app's Bluetooth pairing (and pairing the app again disconnects Home Assistant). Your nightly reports keep arriving in the myAir app, which gets them from ResMed's cloud over the machine's cellular modem; only the app's Bluetooth features (mask-fit test, changing comfort settings from the phone) stop working.\n\nPut the machine in Bluetooth pairing mode, then press Submit. Home Assistant will connect to it."
      },
      "code": {
        "title": "Enter the code",
        "description": "Type the code now shown on the machine's screen.",
        "data": {
          "passkey": "Code"
        }
      }
